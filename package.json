{
  "name": "canvas-editor-pdf",
  "author": "Douglas",
  "license": "MIT",
  "version": "0.7.0",
  "description": "pdf exporter to canvas-editor",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "types": "./dist/types/index.d.ts",
  "main": "./dist/canvas-editor-pdf.umd.js",
  "module": "./dist/canvas-editor-pdf.es.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/canvas-editor-pdf.es.js",
      "require": "./dist/canvas-editor-pdf.umd.js"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node/index.es.js",
      "require": "./dist/node/index.cjs.js"
    },
    "./font/*": "./dist/font/*"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/types/node.d.ts"
      ]
    }
  },
  "homepage": "https://github.com/douglasmatheus/canvas-editor-pdf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglasmatheus/canvas-editor-pdf.git"
  },
  "keywords": [
    "canvas-editor",
    "pdf-exporter"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite build --mode lib-browser --watch",
    "build": "npm run lint && npm run build:browser && npm run build:node:esm && npm run build:node:cjs && npm run build:types",
    "build:browser": "vite build --mode lib-browser",
    "build:node:esm": "vite build --mode lib-node",
    "build:node:cjs": "vite build --mode lib-node-cjs",
    "build:types": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type:check": "tsc -p tsconfig.json --noEmit && tsc -p tests/types/tsconfig.json"
  },
  "peerDependencies": {
    "@hufe921/canvas-editor": ">=0.9.133 <2.0.0",
    "@napi-rs/canvas": "^0.1.0 || ^1.0.0",
    "@resvg/resvg-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@hufe921/canvas-editor": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hufe921/canvas-editor": "^1.0.3",
    "@napi-rs/canvas": "^1.0.0",
    "@resvg/resvg-js": "^2.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.19.0",
    "@types/prismjs": "^1.26.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "pdfjs-dist": "^6.1.200",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "prismjs": "^1.30.0"
  }
}
